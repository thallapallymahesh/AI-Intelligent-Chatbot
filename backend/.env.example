# Local development: ollama must be reachable at OLLAMA_BASE_URL.
AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
AI_CHAT_MODEL=llama3.2
AI_EMBEDDING_MODEL=nomic-embed-text

# Hosted Google Gemini API (Google AI Studio free-tier models, API key required).
# The chosen account must have the Gemini Developer API free tier available;
# do not enable billing. Free quotas and model availability can change.
# AI_PROVIDER=gemini
# AI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# AI_API_KEY=
# AI_CHAT_MODEL=gemini-3.5-flash-lite
# AI_EMBEDDING_MODEL=gemini-embedding-2

# Other hosted OpenAI-compatible providers (requires a provider account and API key).
# Set AI_PROVIDER=openai, then configure AI_API_KEY, AI_API_BASE_URL, and both
# model names. The chosen provider/account must support both chat completions
# and embeddings. No hosted key or model is bundled with this project.
# AI_PROVIDER=openai
# AI_API_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=
# AI_CHAT_MODEL=gpt-4o-mini
# AI_EMBEDDING_MODEL=text-embedding-3-small

# Render Free storage is ephemeral and is cleared on restart/redeploy/spin-down.
APP_DATA_DIR=./data
# Optional separate locations; defaults are inside APP_DATA_DIR.
# DATABASE_PATH=./data/chatbot.db
# CHROMA_DIR=./data/chroma_db
CORS_ORIGINS=http://localhost:5173
